# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Secrets and local environment
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Raw BTS downloads and local generated files
# Keep only the prepared data/model artifacts required by the public Streamlit app.
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep
!data/processed/flights.parquet
!data/processed/passenger_rights_chunks.jsonl

models/*
!models/.gitkeep
!models/flight_delay_model.joblib

# Local MLflow database/artifacts are not needed by the cloud app.
storage/*
!storage/.gitkeep

# MLflow / Chroma local artifacts
mlruns/
chroma/
*.db
*.sqlite
*.sqlite3

# Model artifacts (large files) - keep only production model
*.joblib
*.pkl
!models/flight_delay_model.joblib

# Documents and local temp files
.DS_Store
Thumbs.db
*.log
mlflow-registry-debug.txt
*.zip
*.rar

# Environment and secrets
.env
.env.*
!.env.example
